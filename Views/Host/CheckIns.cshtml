@model List<Booking>
@{
    ViewData["Title"] = "Guest check-ins";
}
<h1>Guest Check-Ins</h1>
@if (Model.Count == 0)
{
    <p>No approved bookings yet.</p>
}
@foreach (var b in Model)
{
    <div class="box">
        <b>@b.Property.Title</b> - @b.Guest.FullName
        (@b.CheckInDate.ToString("yyyy-MM-dd") to @b.CheckOutDate.ToString("yyyy-MM-dd"))
        <span class="status @b.Status.ToString().ToLower()">@b.Status</span><br />
        <span class="muted">Check-in: @b.GuestCheckIn.Status</span>

        @if (b.GuestCheckIn.Documents.Count == 0)
        {
            <p class="muted">The guest has not uploaded a document yet.</p>
        }
        else
        {
            <table>
                <tr><th>Document</th><th>Status</th><th></th></tr>
                @foreach (var d in b.GuestCheckIn.Documents)
                {
                    <tr>
                        <td>@d.DocumentType - <a asp-controller="Documents" asp-action="Download" asp-route-id="@d.Id" target="_blank">Open file</a></td>
                        <td><span class="status @d.Status.ToString().ToLower()">@d.Status</span></td>
                        <td>
                            @if (d.Status == DocumentStatus.Pending)
                            {
                                <form asp-action="VerifyDocument" method="post" class="inline">
                                    <input type="hidden" name="id" value="@d.Id" />
                                    <button type="submit" name="verify" value="true">Verify</button>
                                    <button type="submit" name="verify" value="false" class="grey">Reject</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </table>
        }
    </div>
}
