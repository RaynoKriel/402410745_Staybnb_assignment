@model List<HostProperty>
@{
    ViewData["Title"] = "My properties as a Host";
}
<h1>My Properties</h1>
@if (Model.Count == 0)
{
    <p>No approved properties yet.</p>
}
<div class="grid">
    @foreach (var p in Model)
    {
        <div class="card">
            @if (p.Images.Count > 0)
            {
                <img src="@p.Images[0].ImageUrl" alt="@p.Title" />
            }
            <div class="info">
                <b>@p.Title</b><br />
                <span class="muted">@p.City - R @p.PricePerNight.ToString("N2") / night - @p.Bookings.Count bookings</span><br />
                <span class="status @(p.IsActive ? "active" : "inactive")">@(p.IsActive ? "Active" : "Inactive")</span>
                <p>
                    <a asp-controller="Home" asp-action="Details" asp-route-id="@p.Id">View</a> |
                    <a asp-action="ConfigureCheckIn" asp-route-id="@p.Id">Check-in process</a>
                </p>
                <form asp-action="ToggleActive" method="post">
                    <input type="hidden" name="id" value="@p.Id" />
                    <button type="submit" class="@(p.IsActive ? "grey" : "")">@(p.IsActive ? "Deactivate" : "Activate")</button>
                </form>
            </div>
        </div>
    }
</div>
