@model List<ActivityLog>
@{
    ViewData["Title"] = "Activity logs by Date";
}
<h1>Activity Logs</h1>
<div class="table-wrap">
    <table>
        <tr><th>Date</th><th>User</th><th>Type</th><th>Action</th></tr>
        @foreach (var log in Model)
        {
            <tr>
                <td>@log.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
                <td>@log.User.Email</td>
                <td>@log.ActivityType</td>
                <td>@log.Action</td>
            </tr>
        }
    </table>
</div>
