@model List<HostProperty>
@{
    ViewData["Title"] = "Find your next stay here on Staybnb";
    string selectedType = ViewBag.Type as string;
}
<h1>Choose your next stay. Vacation or just a break, Relax.</h1>

<form method="get" asp-action="Index" class="filters">
    <input type="text" name="city" placeholder="City" value="@ViewBag.City" />
    <select name="type">
        <option value="">All property types</option>
        @foreach (var t in PropertyTypes.All)
        {
            <option value="@t" selected="@(t == selectedType)">@t</option>
        }
    </select>
    <button type="submit">Search</button>
</form>

@if (Model.Count == 0)
{
    <p>No properties found.</p>
}
<div class="grid">
    @foreach (var p in Model)
    {
        <a class="card" asp-action="Details" asp-route-id="@p.Id">
            @if (p.Images.Count > 0)
            {
                <img src="@p.Images[0].ImageUrl" alt="@p.Title" />
            }
            else
            {
                <div class="noimg"></div>
            }
            <div class="info">
                <b>@p.Title</b><br />
                <span class="muted">@p.City - @p.PropertyType</span><br />
                R @p.PricePerNight.ToString("N2") <span class="muted">per night</span>
            </div>
        </a>
    }
</div>
