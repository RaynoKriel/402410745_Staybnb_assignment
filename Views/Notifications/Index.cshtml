@model List<Notification>
@{
    ViewData["Title"] = "Your Notifications Screen";
    int unreadCount = Model.Count(n => !n.IsRead);
}
<h1>Notifications Status (@unreadCount new)</h1>
@if (unreadCount > 0)
{
    <form asp-action="MarkAllRead" method="post">
        <button type="submit" class="grey">Mark all as read</button>
    </form>
    <br />
}
@if (Model.Count == 0)
{
    <p>No notifications yet.</p>
}
@foreach (var n in Model)
{
    <div class="box @(n.IsRead ? "" : "unread")">
        <b>@n.Title</b>
        <span class="status @n.Type.ToString().ToLower()">@n.Type</span>
        <span class="muted">@n.CreatedAt.ToString("yyyy-MM-dd HH:mm") - @(n.IsRead ? "Read" : "Unread")</span><br />
        @n.Message<br />
        <a asp-action="Open" asp-route-id="@n.Id">@(string.IsNullOrEmpty(n.Link) ? "Mark as read" : "Open")</a>
    </div>
}
