@inject _402410745_Staybnb_assignment.Data.ApplicationDbContext Db
@inject Microsoft.AspNetCore.Identity.UserManager<_402410745_Staybnb_assignment.Models.ApplicationUser> Users
@{
    // Counts for the bell icon and the messages link
    int unreadNotifications = 0;
    int unreadMessages = 0;
    if (User.Identity.IsAuthenticated)
    {
        var me = Users.GetUserId(User);
        unreadNotifications = Db.Notifications.Count(n => n.UserId == me && !n.IsRead);
        unreadMessages = Db.Messages.Count(m => m.ReceiverId == me && !m.IsRead);
    }
    bool isAdmin = User.IsInRole("Admin") || User.IsInRole("SuperAdmin");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - 402410745_Staybnb</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
<header>
        <a class="logo" asp-controller="Home" asp-action="Index">402410745_Staybnb</a>
    <nav>
        @if (!User.Identity.IsAuthenticated)
        {
            <a asp-controller="Home" asp-action="Index">Browse</a>
            <a asp-controller="Account" asp-action="Login">Login</a>
            <a asp-controller="Account" asp-action="Register">Register</a>
        }
        else
        {
            if (User.IsInRole("Guest"))
            {
                <a asp-controller="Home" asp-action="Index">Browse</a>
                <a asp-controller="Booking" asp-action="MyBookings">My Bookings</a>
                <a asp-controller="HostApplication" asp-action="Create">Become a Host</a>
                <a asp-controller="HostApplication" asp-action="Index">Application Status</a>
            }
            if (User.IsInRole("Host"))
            {
                <a asp-controller="Host" asp-action="Dashboard">Dashboard</a>
                <a asp-controller="Host" asp-action="MyProperties">My Properties</a>
                <a asp-controller="Host" asp-action="BookingRequests">Booking Requests</a>
                <a asp-controller="Host" asp-action="CheckIns">Check-Ins</a>
                <a asp-controller="HostApplication" asp-action="Create">Add Property</a>
                <a asp-controller="HostApplication" asp-action="Index">Applications</a>
            }
            if (isAdmin)
            {
                <a asp-controller="Admin" asp-action="Dashboard">Dashboard</a>
                <a asp-controller="Admin" asp-action="Applications">Applications</a>
                <a asp-controller="Admin" asp-action="ActivityLogs">Activity Logs</a>
            }
            if (User.IsInRole("SuperAdmin"))
            {
                <a asp-controller="Admin" asp-action="Users">Users</a>
            }
            <a asp-controller="Messages" asp-action="Index">Messages</a>
            if (unreadMessages > 0)
            {
                <span class="badge">@unreadMessages</span>
            }
            <a asp-controller="Notifications" asp-action="Index">Notifications</a>
            if (unreadNotifications > 0)
            {
                <span class="badge">@unreadNotifications</span>
            }
            <form asp-controller="Account" asp-action="Logout" method="post" class="inline">
                <button type="submit" class="link">Logout (@User.Identity.Name)</button>
            </form>
        }
    </nav>
</header>

<main>
    @if (TempData["Message"] != null)
    {
        <div class="alert ok">@TempData["Message"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert error">@TempData["Error"]</div>
    }
    @RenderBody()
</main>

    <footer>402410745_Staybnb - Student Rayno Kriel Assignemnt</footer>
</body>
</html>
