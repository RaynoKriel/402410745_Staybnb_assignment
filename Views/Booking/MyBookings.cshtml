@model List<Booking>
@{
    ViewData["Title"] = "My Bookings";
}
<h1>My Bookings</h1>
@if (Model.Count == 0)
{
    <p>No bookings yet. <a asp-controller="Home" asp-action="Index">Browse properties for a Booking</a>.</p>
}
else
{
    <div class="table-wrap">
        <table>
            <tr><th>Property</th><th>Dates</th><th>Guests</th><th>Total</th><th>Payment</th><th>Status</th><th></th></tr>
            @foreach (var b in Model)
            {
                <tr>
                    <td><a asp-controller="Home" asp-action="Details" asp-route-id="@b.PropertyId">@b.Property.Title</a></td>
                    <td>@b.CheckInDate.ToString("yyyy-MM-dd") to @b.CheckOutDate.ToString("yyyy-MM-dd") (@b.Nights nights)</td>
                    <td>@b.NumberOfGuests</td>
                    <td>R @b.TotalPrice.ToString("N2")</td>
                    <td><span class="status @b.Payment.Status.ToString().ToLower()">@b.Payment.Status</span></td>
                    <td><span class="status @b.Status.ToString().ToLower()">@b.Status</span></td>
                    <td>
                        @if (b.Status == BookingStatus.Approved || b.Status == BookingStatus.CheckedIn)
                        {
                            <a asp-action="CheckIn" asp-route-id="@b.Id">Check-in</a>
                        }
                    </td>
                </tr>
            }
        </table>
    </div>
}
